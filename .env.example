# Clinic Endoscopy Operations System
#
# 1) 이 파일을 `.env`로 복사합니다.
# 2) 아래 `__GENERATE_...__` 값은 그대로 사용하지 말고 서로 다른 난수로 교체합니다.
# 3) `.env`는 Git에 Commit하지 않습니다.
#
# Windows PowerShell 5.1 이상에서 강한 Base64 난수(48 bytes)를 만드는 예:
#   $bytes = New-Object byte[] 48
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
#
# Password 세 개와 SESSION_SECRET은 위 명령을 각각 다시 실행해 서로 다른 값으로
# 만드세요.

COMPOSE_PROJECT_NAME=clinic-endoscopy
APP_VERSION=local
APP_ENV=production
TZ=Asia/Seoul
LOG_LEVEL=INFO

# PostgreSQL 초기 관리자 계정은 Container 초기화에만 사용합니다.
# Backend는 POSTGRES_APP_USER, Migration은 POSTGRES_MIGRATION_USER를 사용합니다.
POSTGRES_DB=clinic_endoscopy
POSTGRES_ADMIN_USER=clinic_db_admin
POSTGRES_ADMIN_PASSWORD=__GENERATE_UNIQUE_ADMIN_PASSWORD__
POSTGRES_MIGRATION_USER=clinic_migration
POSTGRES_MIGRATION_PASSWORD=__GENERATE_UNIQUE_MIGRATION_PASSWORD__
POSTGRES_APP_USER=clinic_runtime
POSTGRES_APP_PASSWORD=__GENERATE_UNIQUE_RUNTIME_PASSWORD__

# Session 원문을 Database Hash와 연결하는 HMAC Key입니다. Container 재시작 시
# 바뀌면 기존 Session이 모두 무효화되므로 운영 중 임의로 변경하지 않습니다.
SESSION_SECRET=__GENERATE_UNIQUE_SESSION_SECRET__

# 연락처·특이사항을 PostgreSQL pgcrypto로 암호화하는 별도 Key입니다.
# SESSION_SECRET과 다른 난수를 사용하고 Database Backup과 분리해 보관합니다.
FIELD_ENCRYPTION_KEY=__GENERATE_UNIQUE_FIELD_ENCRYPTION_KEY__

# 최초 관리자 생성값은 .env에 장기 보관하지 않습니다. README의 명령처럼
# 현재 PowerShell Process의 환경변수로만 설정한 뒤 Seed 완료 즉시 제거합니다.
# BOOTSTRAP_ADMIN_LOGIN_ID=
# BOOTSTRAP_ADMIN_DISPLAY_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# 운영: 내부 DNS 또는 각 직원 PC hosts 파일에 등록한 고정 Hostname을 사용합니다.
# Backend 목록은 쉼표, Caddy 목록은 공백으로 구분합니다. 두 목록에는 실제 원내
# Subnet과 Container 자체 Healthcheck용 127.0.0.1/32만 두세요.
# 아래 예시 192.168.10.0/24는 반드시 실제 값으로 바꿔야 합니다.
CLINIC_HOSTNAME=endoscopy.clinic.local
CLINIC_SITE_ADDRESS=https://endoscopy.clinic.local
CLINIC_ALLOWED_HOSTS=endoscopy.clinic.local
CLINIC_ALLOWED_ORIGINS=https://endoscopy.clinic.local
CLINIC_ALLOWED_SUBNETS=192.168.10.0/24,127.0.0.1/32
CADDY_ALLOWED_SUBNETS=192.168.10.0/24 127.0.0.1/32
CLINIC_BIND_ADDRESS=0.0.0.0
CLINIC_HTTPS_PORT=443

# 개발 PC 한 대에서만 확인할 때 위 관련 값을 다음처럼 바꿀 수 있습니다.
# CLINIC_HOSTNAME=localhost
# CLINIC_SITE_ADDRESS=https://localhost
# CLINIC_ALLOWED_HOSTS=localhost
# CLINIC_ALLOWED_ORIGINS=https://localhost:8443
# CLINIC_ALLOWED_SUBNETS=127.0.0.1/32
# CADDY_ALLOWED_SUBNETS=127.0.0.1/32
# CLINIC_BIND_ADDRESS=127.0.0.1
# CLINIC_HTTPS_PORT=8443

# 보안 정책 기본값입니다. 실제 운영 승인 후 조정할 수 있습니다.
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MAX_LOGIN_FAILURES=5
LOGIN_LOCK_MINUTES=15
TRUSTED_PROXY_SUBNETS=172.16.0.0/12
