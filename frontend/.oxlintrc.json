{
  "plugins": [
    "react",
    "import",
    "typescript",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [
        "src/App.tsx",
        "src/BookingWizard.tsx",
        "src/PatientWorkspace.tsx",
        "src/auth.tsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules"
  ]
}
